[
    {
        "name": "standard-cluster-admin-sa",
        "description": "Used by Standard Insurance Platform Team for Kafka cluster administration activities",
        "roles": [
            {
                "role": "CloudClusterAdmin",
                "resource": {
                    "type": "Cluster",
                    "name": "STANDARD_CLUSTER"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-cluster-admin-sa-api-key",
                "description": "Issued to: standard-cluster-admin-sa, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "Cluster"
            }
        ]
    },
    {
        "name": "standard-sr-admin-sa",
        "description": "Used by Standard Insurance Platform Team for Schema Registry administration activities",
        "roles": [
            {
                "role": "ResourceOwner",
                "resource": {
                    "type": "Subject",
                    "name": "*"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-sr-admin-sa-api-key",
                "description": "Issued to: standard-sr-admin-sa, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "SchemaRegistry"
            }
        ]
    },
    {
        "name": "standard-eda-source-sa",
        "description": "Used by EDA source system to publish EOI events to standard-eda-bentech-eoi",
        "roles": [
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentech-eoi"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-eoi-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-eoi-*"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-eda-source-sa-kafka-api-key",
                "description": "Issued to: standard-eda-source-sa, Owner: Standard Insurance EDA Team",
                "managed_resource_kind": "Cluster"
            },
            {
                "name": "standard-eda-source-sa-sr-api-key",
                "description": "Issued to: standard-eda-source-sa, Owner: Standard Insurance EDA Team",
                "managed_resource_kind": "SchemaRegistry"
            }
        ]
    },
    {
        "name": "standard-flink-bentech-sa",
        "description": "Used by Flink to read EOI events from standard-eda-bentech-eoi, read/write to all standard-eda-bentechdata-flink-* topics, and write to standard-eda-bentech-workday (Flink Step 3 success output)",
        "roles": [
            {
                "role": "FlinkDeveloper",
                "resource": {
                    "type": "Environment",
                    "name": "STANDARD_ENV"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentech-eoi"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentechdata-flink-*",
                    "pattern_type": "PREFIXED"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentechdata-flink-*",
                    "pattern_type": "PREFIXED"
                }
            },
            {
                "_comment": "ADDED: Flink Step 3 (04_transform_workday.sql) writes its success output to this topic. standard-eda-bentech-workday does not match the standard-eda-bentechdata-flink-* prefix so it must be granted explicitly.",
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentech-workday"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-eoi-*"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-flink-*",
                    "pattern_type": "PREFIXED"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-flink-*",
                    "pattern_type": "PREFIXED"
                }
            },
            {
                "_comment": "ADDED: Confluent Avro serializer calls POST /subjects/standard-eda-bentech-workday-{key,value}/versions at Flink statement startup to register/verify the output schema and retrieve its ID. Both DeveloperRead (schema lookup) and DeveloperWrite (registration POST) are required.",
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-workday-*"
                }
            },
            {
                "_comment": "ADDED: Confluent Avro serializer calls POST /subjects/standard-eda-bentech-workday-{key,value}/versions at Flink statement startup to register/verify the output schema and retrieve its ID. Both DeveloperRead (schema lookup) and DeveloperWrite (registration POST) are required.",
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-workday-*"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Group",
                    "name": "confluent-flink",
                    "pattern_type": "PREFIXED"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "TransactionalId",
                    "name": "_confluent-flink_*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "TransactionalId",
                    "name": "_confluent-flink_*"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-flink-bentech-sa-api-key",
                "description": "Issued to: standard-flink-bentech-sa for EOI Flink statement execution, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "FlinkRegion"
            }
        ]
    },
    {
        "name": "standard-connect-sa",
        "description": "Used by CFK Kafka Connect cluster (standard-connect) to manage Connect internal topics. Authenticated via standard-connect-sa-kafka-api-key mounted into the Connect worker pod.",
        "roles": [
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-configs"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-configs"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-offsets"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-offsets"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-status"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-connect-status"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Group",
                    "name": "standard-connect",
                    "pattern_type": "LITERAL"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-connect-sa-kafka-api-key",
                "description": "Issued to: standard-connect-sa, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "Cluster"
            },
            {
                "name": "standard-connect-sa-sr-api-key",
                "description": "Issued to: standard-connect-sa, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "SchemaRegistry"
            }
        ]
    },
    {
        "name": "standard-workday-connector-sa",
        "description": "Used by the Workday HTTP Sink connector. Consumes EOI events from standard-eda-bentech-workday and publishes Workday API outcomes to standard-eda-bentechdata-workday-response, standard-eda-bentechdata-workday-error, and standard-eda-bentechdata-workday-dlq. Configured as the connector principal via kafka.service.account.id so this key rotates independently of the Connect worker.",
        "roles": [
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentech-workday"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentech-workday-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentechdata-workday-response"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-response-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-response-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentechdata-workday-error"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-error-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-error-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Topic",
                    "name": "standard-eda-bentechdata-workday-dlq"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-dlq-*"
                }
            },
            {
                "role": "DeveloperWrite",
                "resource": {
                    "type": "Subject",
                    "name": "standard-eda-bentechdata-workday-dlq-*"
                }
            },
            {
                "role": "DeveloperRead",
                "resource": {
                    "type": "Group",
                    "name": "connect-workday-eoi-sink",
                    "pattern_type": "PREFIXED"
                }
            }
        ],
        "api_key": [
            {
                "name": "standard-workday-connector-sa-kafka-api-key",
                "description": "Issued to: standard-workday-connector-sa for Workday HTTP Sink connector principal auth, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "Cluster"
            },
            {
                "name": "standard-workday-connector-sa-sr-api-key",
                "description": "Issued to: standard-workday-connector-sa for Schema Registry read access, Owner: Standard Insurance Platform Team",
                "managed_resource_kind": "SchemaRegistry"
            }
        ]
    }
]
