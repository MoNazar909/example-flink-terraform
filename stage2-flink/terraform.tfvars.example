# ============================================================
# Confluent Cloud API Credentials
# ============================================================
confluent_cloud_api_key    = ""
confluent_cloud_api_secret = ""

# ============================================================
# Environment and Cluster
# ============================================================
environment_id   = ""   # env-xxxxxx
organization_id  = ""   # UUID from org settings
kafka_cluster_id = ""   # lkc-xxxxxx
flink_catalog    = ""   # top-right catalog dropdown in Flink SQL editor (e.g. default)
flink_database   = ""   # top-right database dropdown in Flink SQL editor (Kafka cluster display name, e.g. cluster_0)

# ============================================================
# Flink Credentials
# ============================================================
flink_rest_endpoint   = ""   # https://flink.<region>.aws.confluent.cloud
flink_api_key         = ""   # from: terraform output flink_runner_api_key_id after Stage 1
flink_api_secret      = ""   # from: terraform output flink_runner_api_key_secret after Stage 1
flink_principal_id    = ""   # sa-xxxxxxx  (from: terraform output flink_runner_sa_id after Stage 1)
flink_compute_pool_id = ""   # lfcp-xxxxxx  (from: terraform output flink_compute_pool_id after Stage 1)

# ============================================================
# UDF Artifact
# Upload the JAR to Confluent Cloud Artifacts first, then paste the ID here
# ============================================================
udf_artifact_id = ""   # cfa-xxxxxx
