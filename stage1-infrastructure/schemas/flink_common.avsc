{
  "type": "record",
  "name": "FlinkCommonKafkaPublish",
  "namespace": "com.standardinsurance.eoi",
  "fields": [
    {"name": "flattenedEvent",  "type": ["null", "string"], "default": null, "doc": "Full event payload serialized as a JSON string"},
    {"name": "exception",       "type": ["null", "string"], "default": null, "doc": "Serialized JSON string describing the exception; populated only on DLQ messages"},
    {"name": "targetBentech",   "type": ["null", "string"], "default": null},
    {"name": "groupId",         "type": ["null", "string"], "default": null},
    {"name": "eventType",       "type": ["null", "string"], "default": null},
    {"name": "correlationId",   "type": ["null", "string"], "default": null}
  ]
}
